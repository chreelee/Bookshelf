@page
@model Bookshelf.Pages.StatisticsModel
@{
    ViewData["Title"] = "Your Bookshelf Statistics";
}

<h2>Your Bookshelf Statistics</h2>
<p>See a summary of how many books, authors, and total pages from your bookshelf.</p>

<table>
    <tr>
        <th>
            Completed Books
        </th>
        <th>
            Authors
        </th>
        <th>
            Pages Read    
        </th>
    </tr> 
    <!-- use at-symbol model like Index.cshtml to access the page model for BookStatistics numbers -->
        <tr>
            <td>
                @Model.BookStatistics.BookCount
            </td>
            <td>
                @Model.BookStatistics.AuthorCount
            </td>
            <td>
                @Model.BookStatistics.PagesCount
            </td>
        </tr>

</table>